{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://returnly.app/policies/schema.json",
  "title": "Returnly retailer return policy (US)",
  "description": "One file per retailer. Every fact carries the official URL it came from and the date it was last checked. Anything the official source doesn't confirm is \"unknown\" and listed under unknowns; nothing is guessed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "country", "status", "checked", "aliases", "item", "categories", "membership", "holiday", "receipt", "refund", "methods", "unknowns", "research"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "country": { "const": "US" },
    "status": { "enum": ["checked", "unverified"] },
    "checked": { "$ref": "#/$defs/date" },
    "aliases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["names", "prefixes"],
      "properties": {
        "names": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2 } },
        "prefixes": { "type": "array", "items": { "type": "string", "minLength": 2 } }
      }
    },
    "item": {
      "description": "Fills the existing item fields one-to-one (policySource is built from name and checked).",
      "type": "object",
      "additionalProperties": false,
      "required": ["window", "basis", "outcome", "requirement", "url", "conditions", "processing"],
      "properties": {
        "window": { "$ref": "#/$defs/fact", "properties": { "value": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "enum": ["none", "unknown"] }] } } },
        "basis": { "$ref": "#/$defs/fact", "properties": { "value": { "enum": ["delivery", "purchase", "shipment", "unknown"] } } },
        "outcome": { "$ref": "#/$defs/fact", "properties": { "value": { "enum": ["refund", "credit", "exchange", "final", "unknown"] } } },
        "requirement": { "$ref": "#/$defs/fact", "properties": { "value": { "enum": ["start", "ship", "arrive", "store", "unknown"] } } },
        "url": { "$ref": "#/$defs/fact", "properties": { "value": { "type": "string", "pattern": "^https://" } } },
        "orderUrl": { "description": "Optional. The retailer's own link to one order's return, with {order} where the order number goes. Only when an official source documents it.", "$ref": "#/$defs/fact", "properties": { "value": { "type": "string", "pattern": "^https://[^\\s]*\\{order\\}" } } },
        "conditions": { "$ref": "#/$defs/fact", "properties": { "value": { "type": "string", "minLength": 1 } } },
        "processing": { "$ref": "#/$defs/fact", "properties": { "value": { "type": "string", "minLength": 1 } } }
      }
    },
    "categories": {
      "description": "Category exceptions: electronics, opened items, final sale, non-returnable categories.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "returnable", "source", "checked"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "label": { "type": "string", "minLength": 1 },
          "examples": { "type": "array", "items": { "type": "string" } },
          "returnable": { "enum": [true, false, "unknown"] },
          "window": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "enum": ["none", "unknown"] }] },
          "basis": { "enum": ["delivery", "purchase", "shipment", "unknown"] },
          "outcome": { "enum": ["refund", "credit", "exchange", "final", "unknown"] },
          "conditions": { "type": "string" },
          "note": { "type": "string" },
          "source": { "$ref": "#/$defs/url" },
          "checked": { "$ref": "#/$defs/date" }
        }
      }
    },
    "membership": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["program", "effect", "source", "checked"],
        "properties": {
          "program": { "type": "string", "minLength": 1 },
          "effect": { "type": "string", "minLength": 1 },
          "window": { "type": "integer", "minimum": 0 },
          "extraDays": { "type": "integer", "minimum": 0 },
          "excludes": { "type": "array", "items": { "type": "string" } },
          "source": { "$ref": "#/$defs/url" },
          "checked": { "$ref": "#/$defs/date" }
        }
      }
    },
    "holiday": {
      "description": "Holiday extended-return rules, one entry per season. A season that has ended stays as history.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["season", "purchasedFrom", "purchasedTo", "returnBy", "source", "checked"],
        "properties": {
          "season": { "type": "string", "pattern": "^\\d{4}$" },
          "purchasedFrom": { "$ref": "#/$defs/date" },
          "purchasedTo": { "$ref": "#/$defs/date" },
          "dateBasis": { "enum": ["purchase", "delivery"] },
          "returnBy": { "anyOf": [{ "$ref": "#/$defs/date" }, { "const": "unknown" }] },
          "appliesTo": { "type": "string" },
          "exceptions": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["label", "returnBy"], "properties": { "label": { "type": "string" }, "returnBy": { "$ref": "#/$defs/date" } } } },
          "note": { "type": "string" },
          "source": { "$ref": "#/$defs/url" },
          "checked": { "$ref": "#/$defs/date" }
        }
      }
    },
    "receipt": {
      "$ref": "#/$defs/fact",
      "properties": { "value": { "type": "object", "additionalProperties": false, "required": ["required", "without"], "properties": { "required": { "enum": [true, false, "unknown"] }, "without": { "type": "string" } } } }
    },
    "refund": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timing", "fees"],
      "properties": {
        "timing": { "$ref": "#/$defs/fact", "properties": { "value": { "type": "string", "minLength": 1 } } },
        "fees": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "amount", "source", "checked"],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "amount": { "type": "string", "minLength": 1 },
              "appliesTo": { "type": "string" },
              "source": { "$ref": "#/$defs/url" },
              "checked": { "$ref": "#/$defs/date" }
            }
          }
        }
      }
    },
    "methods": {
      "description": "Ways to return, easiest first, with what each needs.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "label", "needs", "steps", "source", "checked"],
        "properties": {
          "type": { "enum": ["mail", "dropoff", "store", "pickup"] },
          "label": { "type": "string", "minLength": 1 },
          "partners": { "type": "array", "items": { "type": "string" } },
          "cost": { "type": "string" },
          "needs": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "box", "qr", "printer"],
            "properties": {
              "label": { "enum": [true, false, "unknown"] },
              "box": { "enum": [true, false, "unknown"] },
              "qr": { "enum": [true, false, "unknown"] },
              "printer": { "enum": [true, false, "unknown"] },
              "receipt": { "enum": [true, false, "unknown"] },
              "id": { "enum": [true, false, "unknown"] }
            }
          },
          "steps": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "note": { "type": "string" },
          "source": { "$ref": "#/$defs/url" },
          "checked": { "$ref": "#/$defs/date" }
        }
      }
    },
    "marketplace": { "$ref": "#/$defs/fact", "properties": { "value": { "type": "string", "minLength": 1 } } },
    "unknowns": {
      "description": "Topics the official sources didn't confirm, or where they disagree. Never filled with a guess.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["topic", "note", "source", "checked"],
        "properties": {
          "topic": { "type": "string", "minLength": 1 },
          "note": { "type": "string", "minLength": 1 },
          "source": { "$ref": "#/$defs/url" },
          "checked": { "$ref": "#/$defs/date" }
        }
      }
    },
    "research": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "url": { "type": "string", "pattern": "^https://[^\\s]+$" },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "source", "checked"],
      "properties": {
        "value": {},
        "note": { "type": "string" },
        "source": { "$ref": "#/$defs/url" },
        "checked": { "$ref": "#/$defs/date" }
      }
    }
  }
}
